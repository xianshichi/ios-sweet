 void
+sweet_early_band(uint32_t color)
+{
+	for (unsigned int y = EARLY_HEIGHT - 6; y < EARLY_HEIGHT; y++) {
+		volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
 sweet_early_relocate(uint64_t base)
 {
+	/* Prove liveness of the kernel VA alias: wipe the screen to a dark grey. */
+	for (unsigned int y = 0; y < EARLY_HEIGHT; y++) {
+		volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff101010u;
+		}
+	}
+	sweet_early_band(0xff8000ffu);
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
 	early_fb = (volatile uint32_t *)(uintptr_t)base;
 	__asm__ volatile("dsb sy" ::: "memory");
