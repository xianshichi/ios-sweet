 void
+sweet_early_fill(uint32_t color)
+{
+	for (unsigned int y = 0; y < EARLY_HEIGHT; y++) {
+		volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
