 }
 
+#define STAGE_SCALE 12u
+
+void
+sweet_early_stage(unsigned int stage)
+{
+	static const unsigned int pow10[] = { 1000000000u, 100000000u, 10000000u, 1000000u,
+		100000u, 10000u, 1000u, 100u, 10u, 1u };
+	unsigned int digits[10];
+	unsigned int ndig = 0;
+	unsigned int start = 0;
+
+	for (unsigned int i = 0; i < 10; i++) {
+		unsigned int d = (stage / pow10[i]) % 10u;
+		if (d != 0 || ndig != 0 || i == 9) {
+			digits[ndig++] = d;
+		}
+	}
+	while (ndig > 1 && digits[start] == 0) {
+		start++;
+	}
+
+	for (unsigned int y = 0; y < EARLY_HEIGHT; y++) {
+		volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+
+	unsigned int cellw = 8u * STAGE_SCALE;
+	unsigned int cellh = 16u * STAGE_SCALE;
+	unsigned int total = (ndig - start) * cellw;
+	unsigned int ox = (EARLY_WIDTH - total) / 2u;
+	unsigned int oy = (EARLY_HEIGHT - cellh) / 2u;
+
+	for (unsigned int k = start; k < ndig; k++) {
+		const unsigned char *glyph = iso_font + digits[k] * 16;
+		unsigned int gx0 = ox + (k - start) * cellw;
+		for (unsigned int gy = 0; gy < 16; gy++) {
+			for (unsigned int sy = 0; sy < STAGE_SCALE; sy++) {
+				volatile uint32_t *line = EARLY_FB + (oy + gy * STAGE_SCALE + sy) * EARLY_STRIDE + gx0;
+				for (unsigned int gx = 0; gx < 8; gx++) {
+					uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+					for (unsigned int sx = 0; sx < STAGE_SCALE; sx++) {
+						line[gx * STAGE_SCALE + sx] = pixel;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
